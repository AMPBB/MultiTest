<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".doublesurfacefbo.DoubleSurfaceFboActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/double_surface_label_a"
            android:text="View A (red→FBO a1, green→FBO a2, blit a1→screen)"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#33000000"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <pbbadd.opengl.multitest.doublesurfacefbo.DoubleSurfaceFboView
            android:id="@+id/double_surface_view_a"
            android:layout_width="960px"
            android:layout_height="540px"/>

        <View
            android:id="@+id/double_surface_divider"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#FF0000FF" />

        <TextView
            android:id="@+id/double_surface_label_b"
            android:text="View B (red→FBO b1, green→FBO b2, blit b1→screen)"
            android:textSize="12sp"
            android:gravity="center"
            android:background="#33000000"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <pbbadd.opengl.multitest.doublesurfacefbo.DoubleSurfaceFboView
            android:id="@+id/double_surface_view_b"
            android:layout_width="960px"
            android:layout_height="540px"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
