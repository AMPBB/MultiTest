<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".graphicbuffer.GraphicBufferActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <EditText
                android:id="@+id/edit_graphic_buffer_width"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="width"
                android:inputType="number"
                android:text="256" />

            <EditText
                android:id="@+id/edit_graphic_buffer_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="height"
                android:inputType="number"
                android:text="256" />

            <Button
                android:id="@+id/button_graphic_buffer_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="start" />

            <Button
                android:id="@+id/button_graphic_buffer_destroy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="destroy" />

            <TextView
                android:id="@+id/text_graphic_buffer_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="info"
                android:textColor="#222222"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
